{
  "name": "@pancake/ui",
  "version": "0.1.0",
  "description": "Thư viện component React của Pancake Web — antd v6 + token @pancake/tokens (DS_AI v1.3)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./docs/*": "./docs/*"
  },
  "files": [
    "dist",
    "docs"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "gallery": "vite build -c gallery/vite.config.ts && node gallery/render.mjs"
  },
  "peerDependencies": {
    "antd": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@pancake/tokens": "1.3.0",
    "@phosphor-icons/react": "^2.1.7"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "^10.6.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
